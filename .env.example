# Dostawca modelu: mock | anthropic | openai | ollama
AI_PROVIDER=mock

# Claude (API Anthropic). Brama sama dobiera model do trudności pytania: tani do prostych, mocny do analiz.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
# ANTHROPIC_MODEL_STRONG=claude-opus-5-5   # albo claude-sonnet-5-5, gdy liczy się koszt
# MODEL=                                   # ustawia jeden model na sztywno dla wszystkich pytań

# OpenAI
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini

# Model lokalny (Ollama)
# OLLAMA_URL=http://localhost:11434
# MODEL=llama3.1

PORT=3000

# Szyfrowanie danych na dysku (AES-256-GCM): 64 znaki hex. Wygeneruj: openssl rand -hex 32
# Zapisz klucz także w menedżerze haseł: bez niego dane i kopie zapasowe są nie do odczytania.
# DATA_KEY=

# Trasowanie danych chronionych (PESEL, numer konta, zdrowie, wynagrodzenia):
# gdy OLLAMA_URL jest ustawione, takie wiadomości idą wyłącznie do modelu lokalnego;
# bez niego nie wychodzą nigdzie, a użytkownik dostaje komunikat.
# Webhook alertu dla administratora przy zablokowanej wiadomości (Teams / Slack / n8n), bez treści:
# ALERT_WEBHOOK_URL=https://...

# Polityka per dział: którzy dostawcy są dozwoleni (ustawia administrator, pracownik wybiera tylko spośród nich).
# Domyślnie księgowość i zarząd mają tylko serwer firmy (mock, ollama), reszta także chmurę.
# DEPT_POLICY_JSON={"ksiegowosc":["mock","ollama"],"zarzad":["mock","ollama"],"*":["mock","ollama","anthropic","openai"]}

# Miesięczny limit zapytań do chmury na dział (po wyczerpaniu: model w firmie albo zatrzymanie)
# CLOUD_MONTHLY_LIMIT=500

# Bezpiecznik kosztów: łączny budżet na chmurę w USD na miesiąc dla całej aplikacji (0 = bez limitu).
# Po przekroczeniu pytania wracają do modelu w firmie albo trybu pokazowego. Wymaga PRICING_JSON.
# Drugi, twardy bezpiecznik: limit wydatków w konsoli Anthropic (Settings → Limits).
# APP_MONTHLY_BUDGET_USD=3

# Cennik do licznika kosztów, USD za 1 mln tokenów, według aktualnego cennika dostawcy
# PRICING_JSON={"claude-haiku-5-5":{"in":0.1,"out":0.5},"claude-sonnet-5-5":{"in":2,"out":10},"claude-opus-5-5":{"in":4,"out":20}}   # sprawdź aktualny cennik dostawcy
