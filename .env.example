# Dostawca modelu: mock | anthropic | openai | ollama
AI_PROVIDER=mock

# Claude (API Anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-opus-5-5          # albo tańszy do demo: claude-sonnet-5-5

# OpenAI
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini

# Model lokalny (Ollama)
# OLLAMA_URL=http://localhost:11434
# MODEL=llama3.1

PORT=3000

# Trasowanie danych chronionych (PESEL, numer konta, zdrowie, wynagrodzenia):
# gdy OLLAMA_URL jest ustawione, takie wiadomości idą wyłącznie do modelu lokalnego;
# bez niego nie wychodzą nigdzie, a użytkownik dostaje komunikat.
# Webhook alertu dla administratora przy zablokowanej wiadomości (Teams / Slack / n8n), bez treści:
# ALERT_WEBHOOK_URL=https://...

# Polityka per dział: którzy dostawcy są dozwoleni (ustawia administrator, pracownik wybiera tylko spośród nich).
# Domyślnie księgowość i zarząd mają tylko serwer firmy (mock, ollama), reszta także chmurę.
# DEPT_POLICY_JSON={"ksiegowosc":["mock","ollama"],"zarzad":["mock","ollama"],"*":["mock","ollama","anthropic","openai"]}

# Miesięczny limit zapytań do chmury na dział (po wyczerpaniu: model lokalny albo zatrzymanie w bramie)
# CLOUD_MONTHLY_LIMIT=500

# Cennik do licznika kosztów, USD za 1 mln tokenów, według aktualnego cennika dostawcy
# PRICING_JSON={"anthropic":{"in":4,"out":20}}   # claude-opus-5-5; dla claude-sonnet-5-5: {"in":2,"out":10}. Sprawdź aktualny cennik dostawcy.
